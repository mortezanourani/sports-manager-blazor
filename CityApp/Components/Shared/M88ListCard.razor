@using Microsoft.AspNetCore.Components.QuickGrid

@rendermode InteractiveServer

@if (Facilities is null)
{
	<Loading CardMode=true />
}
else
{
	<div class="list-wrapper mb-4">
		<div class="list-header">
			<div class="header-title">
				<h6 class="title text-3">فهرست اماکن دولتی ورزش و جوانان</h6>
			</div>
			@{
				var currentPage = pagination.CurrentPageIndex;
				var lastPage = pagination.LastPageIndex;
				<div class="paginator">
					<nav role="navigation">
						<button @onclick="@(() => GoToPageAsync(currentPage - 1))"
								disabled=@((currentPage <= 0) ? "disabled" : false)>
							<img src="/icons/arrow-right.svg" />
						</button>
						<button @onclick="@(() => GoToPageAsync(currentPage + 1))"
								disabled=@((currentPage >= lastPage) ? "disabled" : false)>
							<img src="/icons/arrow-left.svg" />
						</button>
					</nav>
				</div>
			}
		</div>
		<div class="table-wrapper">
			@if (Facilities is null)
			{
				<Loading CardMode="true" />
			}
			else
			{
				<QuickGrid Items="Facilities.AsQueryable()" Theme="" Class="quickgrid-table" Pagination="@pagination">
					<TemplateColumn Class="action-button" Title="">
						<img src="@string.Format("/icons/gender-{0}.svg", context.UsersGender.Name).ToLower()" />
					</TemplateColumn>
					<TemplateColumn Class="title bold" Title="عنوان مکان ورزشی">
						<div class="names-wrapper">
							<h4 class="header-5">@context.Name</h4>
							<p class="text-4">@context.Address</p>
						</div>
					</TemplateColumn>
					<TemplateColumn Class="light text-3" Title="روباز">
						<div class="names-wrapper">
							<h4 class="header-6">@context.SportLandArea</h4>
							<p class="text-5">مترمربع</p>
						</div>
					</TemplateColumn>
					<TemplateColumn Class="light text-3" Title="سرپوشیده">
						<div class="names-wrapper">
							<h4 class="header-6">@context.SportHallArea</h4>
							<p class="text-5">مترمربع</p>
						</div>
					</TemplateColumn>
					<TemplateColumn Class="light text-3" Title="مساحت کل">
						<div class="names-wrapper">
							<h4 class="header-5">@context.Area</h4>
						</div>
					</TemplateColumn>
					<PropertyColumn Class="light text-3" Title="روباز/سرپوشیده" Property="@(m => m.Type == null ? "" : m.Type.PersianTitle)" />
					<PropertyColumn Class="light text-3" Title="شماره تماس" Property="@(m => m.Phone)" />
					@*
					<TemplateColumn Class="action-button">
						<a href="@string.Format("/M88/{0}", context.Id)">
							<img src="/icons/info.svg" />
						</a>
					</TemplateColumn>
					*@
				</QuickGrid>
			}
		</div>
	</div>
}

@code {
	private List<Facility>? Facilities;

	protected override async Task OnParametersSetAsync()
	{
		Facilities = null;

		using var context = DbFactory.CreateDbContext();

		Facilities = await context.Facilities
			.Include(m => m.FacilityContracts)
			.Include(m => m.UsersGender)
			.Include(m => m.Type)
			.OrderBy(m => m.Name)
			.ToListAsync();

		StateHasChanged();
	}

	private PaginationState pagination = new PaginationState { ItemsPerPage = 5 };

	private async Task GoToPageAsync(int pageIndex)
	{
		await pagination.SetCurrentPageIndexAsync(pageIndex);
	}

	private string? PageButtonClass(int pageIndex)
		=> pagination.CurrentPageIndex == pageIndex ? "current" : null;

	private string? AriaCurrentValue(int pageIndex)
		=> pagination.CurrentPageIndex == pageIndex ? "page" : null;
}
