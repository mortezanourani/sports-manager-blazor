@using Microsoft.AspNetCore.Components.QuickGrid

@rendermode InteractiveServer

@if (Facilities is null)
{
	<Loading CardMode=true />
}
else
{
	<div class="list-wrapper mb-4">
		<div class="list-header">
			<div class="header-title">
				<h6 class="title text-3">فهرست باشگاه های خصوصی شهرستان</h6>
			</div>
			@{
				var currentPage = pagination.CurrentPageIndex;
				var lastPage = pagination.LastPageIndex;
				<div class="paginator">
					<nav role="navigation">
						<button @onclick="@(() => GoToPageAsync(currentPage - 1))"
								disabled=@((currentPage <= 0) ? "disabled" : false)>
							<img src="/icons/arrow-right.svg" />
						</button>
						<button @onclick="@(() => GoToPageAsync(currentPage + 1))"
								disabled=@((currentPage >= lastPage) ? "disabled" : false)>
							<img src="/icons/arrow-left.svg" />
						</button>
					</nav>
				</div>
			}
		</div>
		<div class="table-wrapper">
			@if (Facilities is null)
			{
				<Loading CardMode="true" />
			}
			else
			{
				<QuickGrid Items="Facilities.AsQueryable()" Theme="" Class="quickgrid-table" Pagination="@pagination">
 					<TemplateColumn Class="action-button" Title="">
						@if(context.PrivateFacilityLicenses.Count > 0)
						{
							@if (context.PrivateFacilityLicenses.FirstOrDefault()!.UsersGender == 0)
                            {
                                <img src="/icons/gender-male-only.svg" />
                            }
							else if (context.PrivateFacilityLicenses.FirstOrDefault()!.UsersGender == 1)
                            {
                                <img src="/icons/gender-female-only.svg" />
                            }
                            else
                            {
                                <img src="/icons/gender-mixed-gender.svg" />
                            }
						}
					</TemplateColumn>
					<TemplateColumn Class="title bold" Title="عنوان باشگاه">
						<div class="names-wrapper">
							<h4 class="header-5">@context.Name</h4>
							@if(context.PrivateFacilityLicenses.Count > 0)
							{
								<p class="text-5">@context.PrivateFacilityLicenses.OrderByDescending(m => m.ExpireDate).FirstOrDefault()!.Serial</p>
							}
						</div>
					</TemplateColumn>
					<PropertyColumn Class="light text-3" Title="مدیر" Property="@(m => m.PrivateFacilityLicenses.Count != 0 ? m.PrivateFacilityLicenses.FirstOrDefault()!.Name : "")" />
					<PropertyColumn Class="light text-3" Title="تلفن باشگاه" Property="@(m => m.Phone)" />
					<PropertyColumn Class="light text-3" Title="شماره همراه" Property="@(m => m.PrivateFacilityLicenses.Count > 0 ? m.PrivateFacilityLicenses.FirstOrDefault()!.Phone : "")" />
					@*
					<TemplateColumn Class="info-button">
						<a href="@string.Format("/M5/{0}", context.Id)">
							<img src="/icons/info.svg" />
						</a>
					</TemplateColumn>
					*@
				</QuickGrid>
			}
		</div>
	</div>
}

@code {
	private List<PrivateFacility>? Facilities;

	protected override async Task OnParametersSetAsync()
	{
		Facilities = null;

		using var context = DbFactory.CreateDbContext();

		Facilities = await context.PrivateFacilities
			.Include(m => m.PrivateFacilityLicenses)
			.OrderBy(m => m.Name)
			.ToListAsync();

		StateHasChanged();
	}

	private PaginationState pagination = new PaginationState { ItemsPerPage = 7 };

	private async Task GoToPageAsync(int pageIndex)
	{
		await pagination.SetCurrentPageIndexAsync(pageIndex);
	}

	private string? PageButtonClass(int pageIndex)
		=> pagination.CurrentPageIndex == pageIndex ? "current" : null;

	private string? AriaCurrentValue(int pageIndex)
		=> pagination.CurrentPageIndex == pageIndex ? "page" : null;
}
