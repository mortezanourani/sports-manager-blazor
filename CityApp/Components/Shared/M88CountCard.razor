@using System.Globalization

<div class="card bordered-card white-card athletes-count-card">
	<h5 class="header-6 card-title">اماکن ورزشی دولتی</h5>
	<div class="count-cols-wrapper">
		<div class="count-col">
			<p class="display-6">واگذار شده</p>
			<h4 class="header-5">@($"{hasDocument:#,0}")</h4>
		</div>
		<hr class="vertical-seperator" />
		<div class="count-col">
			<p class="display-6">تحت تصدی</p>
			<h4 class="header-5">@($"{noDocument:#,0}")</h4>
		</div>
	</div>
	<div class="count-row">
		<p class="display-6">تعداد اماکن ورزشی دولتی</p>
		<h6 class="header-5">@($"{totalCount:#,0}")</h6>
	</div>
</div>

@code {
    private int? totalCount = null!;
    private int? noDocument = null!;
    private int? hasDocument = null!;

    protected override async Task OnParametersSetAsync()
    {
        totalCount = null;

        using var context = DbFactory.CreateDbContext();

        var facilities = await context.Facilities
            .Include(m => m.FacilityContracts)
            .ToListAsync();

        totalCount = facilities.Count();

        hasDocument = facilities
            .Count(f => f.FacilityContracts.Any());

        noDocument = totalCount - hasDocument;
    }
}
