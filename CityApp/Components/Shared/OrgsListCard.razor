@using Microsoft.AspNetCore.Components.QuickGrid

@rendermode InteractiveServer

@if (Facilities is null)
{
	<Loading CardMode=true />
}
else
{
	<div class="list-wrapper mb-4">
		<div class="list-header">
			<div class="header-title">
				<h6 class="title text-3">فهرست اماکن سایر ارگان های دولتی</h6>
			</div>
			@{
				var currentPage = pagination.CurrentPageIndex;
				var lastPage = pagination.LastPageIndex;
				<div class="paginator">
					<nav role="navigation">
						<button @onclick="@(() => GoToPageAsync(currentPage - 1))"
								disabled=@((currentPage <= 0) ? "disabled" : false)>
							<img src="/icons/arrow-right.svg" />
						</button>
						<button @onclick="@(() => GoToPageAsync(currentPage + 1))"
								disabled=@((currentPage >= lastPage) ? "disabled" : false)>
							<img src="/icons/arrow-left.svg" />
						</button>
					</nav>
				</div>
			}
		</div>
		<div class="table-wrapper">
			@if (Facilities is null)
			{
				<Loading CardMode="true" />
			}
			else
			{
				<QuickGrid Items="Facilities.AsQueryable()" Theme="" Class="quickgrid-table" Pagination="@pagination">
					<TemplateColumn Class="action-button" Title="">
						<img src="@string.Format("/icons/gender-{0}.svg", context.GovernmentFacilityLicenses.FirstOrDefault()!.UsersGender.Name).ToLower()" />
					</TemplateColumn>
					<TemplateColumn Class="title bold" Title="عنوان مکان ورزشی">
						<div class="names-wrapper">
							<h4 class="header-5">@context.Name</h4>
							<p class="text-5">@context.GovernmentFacilityLicenses.OrderByDescending(m => m.ExpireDate).FirstOrDefault()!.Serial</p>
						</div>
					</TemplateColumn>
					<PropertyColumn Class="light text-3" Title="مدیر" Property="@(m => m.GovernmentFacilityLicenses.FirstOrDefault()!.Name)" />
					<PropertyColumn Class="light text-3" Title="تلفن باشگاه" Property="@(m => m.Phone)" />
					<PropertyColumn Class="light text-3" title="شماره همراه" Property="@(m => m.GovernmentFacilityLicenses.FirstOrDefault()!.Phone)" />
				</QuickGrid>
			}
		</div>
	</div>
}

@code {
	private List<GovernmentFacility>? Facilities;

	protected override async Task OnParametersSetAsync()
	{
		Facilities = null;

		using var context = DbFactory.CreateDbContext();

		Facilities = await context.GovernmentFacilities
			.Include(m => m.GovernmentFacilityLicenses)
				.ThenInclude(m => m.UsersGender)
			.OrderBy(m => m.Name)
			.ToListAsync();

		StateHasChanged();
	}

	private PaginationState pagination = new PaginationState { ItemsPerPage = 5 };

	private async Task GoToPageAsync(int pageIndex)
	{
		await pagination.SetCurrentPageIndexAsync(pageIndex);
	}

	private string? PageButtonClass(int pageIndex)
		=> pagination.CurrentPageIndex == pageIndex ? "current" : null;

	private string? AriaCurrentValue(int pageIndex)
		=> pagination.CurrentPageIndex == pageIndex ? "page" : null;
}
