@page "/Panel/Accounts/AssignPolicies/{UserId}"

@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.QuickGrid

@inject UserManager<CityUser> UserManager
@inject RoleManager<CityRole> RoleManager

@rendermode InteractiveServer

<PageTitle>حساب کاربری</PageTitle>

<div class="row form-wrapper">
    <div class="col3-5 mb-0">
        <h6 class="display-4 mb-3">تعیین سیاست های دسترسی</h6>
        <div class="instructions">
            <p class="mb-3">جهت تغییر رمز عبور خود، می بایست رمز عبور کنونی خود را بدانید. اگر رمز عبور فعلی خود را به یاد نمی آورید لطفا به مدیریت سامانه اطلاع دهید تا نسبت به تعریف رمز عبور جدید (موقت) برای شما اقدام نمایند.</p>
            <div class="instruction-item">
                <div class="icon-title mb-2">
                    <img src="/icons/fingerprint-blue.svg">
                    <h6>رمز عبور جدید:</h6>
                </div>
                <p>در فرم مربوطه فیلد اول رمز عبور جدیدی است که می خواهید برای حساب کاربری خود تعیین نمایید.</p>
                <p>جهت اطمینان از اینکه رمز عبور خود را درست وارد نموده اید می بایست رمز عبور جدید خود را در فیلد دوم مجددا وارد نمایید. بدیهی است که در صورت مغایرت این دو، رمز عبور تغییر نخواهد کرد.</p>
            </div>
        </div>
    </div>
    <div class="col2-5 mb-auto">
        @if (User is null || Roles is null)
        {
            <Loading CardMode=true />
        }
        else
        {
            <div class="card bordered-card">
                <div class="form-group fa mb-3">
                    <label for="accountid" class="form-label">
                        <img src="/icons/user.svg" />
                    </label>
                    <div class="form-control">
                        @User.FirstName @User.LastName
                    </div>
                </div>
                <div class="mb-3">
                    <EditForm Model="Role" FormName="change-password" OnValidSubmit="AddRole" method="post">
                        <div class="form-row">
                            <div class="form-group">
                                <label for="rolename" class="form-label">
                                    <img src="/icons/dropdown.svg" />
                                </label>
                                <InputSelect id="rolename" @bind-Value="Role!.Name" class="form-control w-100">
                                    @foreach (CityRole role in Roles!)
                                    {
                                        <option value="@role.Name">@role.Title</option>
                                    }
                                </InputSelect>
                            </div>
                            <button type="submit" class="btn btn-primary flex-grow-0">
                                <img src="/icons/person-add.svg" />
                            </button>
                        </div>
                    </EditForm>
                </div>
                <hr class="white-space" />
                <div class="list-wrapper">
                    @if (UserRoles is null && UserRoles is null)
                    {
                        <Loading />
                    }
                    else
                    {
                        <div class="table-wrapper">
                            <QuickGrid Items="UserRoles.AsQueryable()" Theme="" Class="quickgrid-table">
                                <TemplateColumn Class="action-button">
                                    <button class="btn p-0" @onclick="() => RemoveRole(context.Name)">
                                        <img src="/icons/person-remove.svg" />
                                    </button>
                                </TemplateColumn>
                                <PropertyColumn Class="" Title="Role" Property="@(role => role.Title)" />
                            </QuickGrid>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public string? UserId { get; set; }

    [SupplyParameterFromForm]
    private CityRole? Role { get; set; } = new();

    private List<CityRole>? Roles;

    private CityUser? User;
    private List<CityRole>? UserRoles = new();

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();

        User = await UserManager.Users
            .Where(u => u.Id == UserId!)
            .FirstOrDefaultAsync();

        if (User is null)
        {
            NavigationManager.NavigateTo("/NotFound");
        }

        Roles = await RoleManager.Roles
            .OrderBy(role => role.Title)
            .ToListAsync();

        await UpdateLists();
        return;
    }

    private async Task UpdateLists()
    {
        CityUser? user = await UserManager.FindByIdAsync(User!.Id!);
        if (user is null) return;

        var userRoles = await UserManager.GetRolesAsync(user!);
        UserRoles = await RoleManager.Roles
            .Where(r => userRoles.Contains(r.Name!))
            .ToListAsync();

        StateHasChanged();
        return;
    }

    private async Task AddRole()
    {
        CityUser? user = await UserManager.FindByIdAsync(User!.Id!);
        if (user is null) return;

        try
        {
            await UserManager.AddToRoleAsync(user!, Role!.Name);
        }
        catch (Exception ex)
        {
            var error = ex;
        }

        await UpdateLists();
        return;
    }

    private async Task RemoveRole(string Role)
    {
        CityUser? user = await UserManager.FindByIdAsync(User!.Id!);
        if (user is null) return;

        await UserManager.RemoveFromRoleAsync(user!, Role!);

        await UpdateLists();
        return;
    }
}
